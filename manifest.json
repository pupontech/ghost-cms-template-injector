{
  "manifest_version": 3,
  "name": "Ghost Preset Toolbar",
  "version": "0.2.0",
  "description": "Preset toolbar for Ghost Admin. Phase-4: popup editor detection, options CRUD, and an optional floating preset toolbar.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Ghost Preset Toolbar",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "content_scripts": [],
  "permissions": ["storage", "scripting"],
  "host_permissions": [],
  "optional_host_permissions": ["https://*/*"]
}
