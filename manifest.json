{
  "manifest_version": 3,
  "name": "Ghost-CMS Template Injector",
  "version": "0.5.4",
  "description": "Applies validated CMS presets to Ghost Admin posts and pages from the extension menu, with explicit per-installation host consent and Ghost-native saves.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Ghost-CMS Template Injector",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "content_scripts": [],
  "permissions": ["storage", "scripting"],
  "host_permissions": [],
  "optional_host_permissions": ["https://*/*"]
}
