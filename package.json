{
  "name": "ghost-cms-template-injector",
  "version": "0.1.0",
  "private": true,
  "description": "Secure MV3 preset toolbar for Ghost Admin posts and pages.",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "manifest:validate": "node scripts/validate-manifest.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:debug": "DEBUG_BUILD=1 npm run build",
    "audit:high": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run manifest:validate"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.9.1",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
